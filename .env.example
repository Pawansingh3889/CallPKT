# Twilio — from a free trial account (twilio.com/try-twilio), no credit card needed.
# Only required once you go live; scripts/simulate_call.py needs none of this.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# LLM for the dialogue manager. Default target is Groq's free tier
# (console.groq.com), OpenAI-compatible endpoint. Any OpenAI-compatible
# endpoint works: change LLM_BASE_URL and LLM_MODEL together.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Set true only once TWILIO_AUTH_TOKEN above is a real value from your account;
# request-signature validation needs it to check incoming webhooks are really from Twilio.
VALIDATE_TWILIO_SIGNATURE=false
